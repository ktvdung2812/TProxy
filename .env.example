# Official local-development secrets for tproxy.
# Copy to .env.run (or export manually) before starting the server:
#   cp .env.example .env.run
#
# Generate a new master key when bootstrapping a fresh database:
#   go run ./cmd/tproxy --print-master-key

TPROXY_API_KEY=replace-with-client-api-key
TPROXY_MASTER_KEY=replace-with-print-master-key-output

# Dashboard login password defaults to 123123 for a new local install.
# It is stored as a salted verifier, never plaintext. Change it from Settings
# before enabling LAN, remote, or tunnel management. Non-loopback management
# requires TPROXY_MANAGEMENT_SECRET.

# Optional: GitHub PAT for `git push` (store only in .env.run, never commit)
# GITHUB_TOKEN=replace-with-token

# Optional Cloudflare Quick Tunnel binary override. The built-in release is
# pinned and checksummed. For a custom immutable release version or HTTPS URL,
# set the matching SHA-256 digest. Keep real values in .env.run, never commit.
# TPROXY_CLOUDFLARED_VERSION=<release-version>
# TPROXY_CLOUDFLARED_SHA256=<official-asset-sha256>
# TPROXY_CLOUDFLARED_URL=https://github.com/cloudflare/cloudflared/releases/download/<version>/<asset>

# Clusters
# Auto-join while standalone; retries while the Hub is unreachable.
# TPROXY_CLUSTER_JOIN_TOKEN=tpc1_<token>
# Set the node name used when auto-joining.
# TPROXY_CLUSTER_NODE_NAME=MyNode
# Allow plain HTTP for an eligible loopback, LAN or Tailscale Hub.
# TPROXY_CLUSTER_ALLOW_INSECURE=1
# Disable cluster background work.
# TPROXY_SKIP_CLUSTER_AUTO=1
