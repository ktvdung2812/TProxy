# tproxy personal-server runtime env.
# Copy to .env before starting the server:
#   cp .env.example .env
#
# Generate a new master key on this machine:
#   ./bin/tproxy-linux-amd64 --print-master-key
# or, on arm64:
#   ./bin/tproxy-linux-arm64 --print-master-key

TPROXY_API_KEY=replace-with-client-api-key
TPROXY_MANAGEMENT_SECRET=replace-with-management-secret
TPROXY_MASTER_KEY=replace-with-print-master-key-output

# Dashboard login defaults to 123123 on first install and is stored as a
# salted verifier. Set TPROXY_MANAGEMENT_SECRET for all non-loopback management.

# Provider secrets used by config.yaml. Set only the providers you enable.
# OPENAI_API_KEY=sk-...
# TPROXY_PROVIDER_CLIENT_ID=...
# TPROXY_PROVIDER_CLIENT_SECRET=...

# The built-in Cloudflare tunnel binary is version- and checksum-pinned. For a
# custom immutable release, set its official SHA-256 digest (never use latest).
# TPROXY_CLOUDFLARED_VERSION=<release-version>
# TPROXY_CLOUDFLARED_SHA256=<official-asset-sha256>
# TPROXY_ANTIGRAVITY_CLIENT_SECRET=...
