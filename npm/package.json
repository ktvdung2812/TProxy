{
  "name": "@ktvdung1606/tproxy",
  "version": "0.1.10",
  "description": "npm wrapper for the tproxy AI gateway binary — includes system tray and auto-start",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktvdung2812/TProxy.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "tproxy": "bin/tproxy.js"
  },
  "files": [
    "bin",
    "lib",
    "config.default.yaml"
  ],
  "scripts": {
    "postinstall": "node -e \"try{require('./lib/trayRuntime').ensureTrayRuntime({silent:true})}catch(e){}\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "gateway",
    "proxy",
    "llm",
    "openai",
    "tray",
    "autostart"
  ]
}
